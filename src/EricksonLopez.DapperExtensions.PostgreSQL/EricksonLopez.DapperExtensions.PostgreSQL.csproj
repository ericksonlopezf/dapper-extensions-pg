<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>EricksonLopez.DapperExtensions.PostgreSQL</AssemblyName>
    <RootNamespace>EricksonLopez.DapperExtensions.PostgreSQL</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>EricksonLopez.DapperExtensions.PostgreSQL</PackageId>
    <Description>High-performance Dapper extensions for PostgreSQL. Bulk insert and upsert via UNNEST (10-50x faster than row-by-row), paginated queries returning PagedList&lt;T&gt;, transaction helpers, and JSONB type handler. Designed for enterprise .NET applications using Clean Architecture.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <!-- SharedKernel: auto-detect local project vs NuGet package.
       Uses ProjectReference when the sibling repo exists locally (dev workflow).
       Falls back to PackageReference for CI builds or when the sibling repo is absent. -->
  <ItemGroup Condition="Exists('..\..\..\dotnet-shared-kernel\src\EricksonLopez.SharedKernel\EricksonLopez.SharedKernel.csproj')">
    <ProjectReference Include="..\..\..\dotnet-shared-kernel\src\EricksonLopez.SharedKernel\EricksonLopez.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('..\..\..\dotnet-shared-kernel\src\EricksonLopez.SharedKernel\EricksonLopez.SharedKernel.csproj')">
    <PackageReference Include="EricksonLopez.SharedKernel" Version="4.0.0" />
  </ItemGroup>

</Project>
